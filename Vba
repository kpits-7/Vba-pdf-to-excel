Sub PDFToExcel_NativeExport()

    '======================================================
    Const SOURCE_FOLDER As String = "C:\Users\YourName\Documents\PDFs\"
    Const PDF_FILENAME  As String = "your_file.pdf"
    Const OUTPUT_FOLDER As String = "C:\Users\YourName\Documents\Output\"
    Const OUTPUT_XLSX   As String = "ExtractedData.xlsx"
    '======================================================

    Dim pdfPath  As String
    Dim xlsxPath As String

    pdfPath  = SOURCE_FOLDER & PDF_FILENAME
    xlsxPath = OUTPUT_FOLDER & OUTPUT_XLSX

    If Dir(pdfPath) = "" Then
        MsgBox "PDF not found: " & pdfPath, vbCritical
        Exit Sub
    End If

    If Dir(OUTPUT_FOLDER, vbDirectory) = "" Then
        MkDir OUTPUT_FOLDER
    End If

    Dim acroApp As Object
    Dim acroDoc As Object
    Dim jsObj   As Object

    On Error GoTo AcrobatError

    Set acroApp = CreateObject("AcroExch.App")
    Set acroDoc = CreateObject("AcroExch.PDDoc")

    If Not acroDoc.Open(pdfPath) Then
        MsgBox "Could not open PDF.", vbCritical
        GoTo Cleanup
    End If

    Set jsObj = acroDoc.GetJSObject

    ' Export directly to Excel format — preserves tables and layout
    jsObj.saveAs xlsxPath, "com.adobe.acrobat.xlsx"

    ' Wait for file to appear
    Dim t As Single
    t = Timer
    Do While Dir(xlsxPath) = "" And Timer - t < 30
        DoEvents
    Loop

    acroDoc.Close
    acroApp.Exit

    If Dir(xlsxPath) = "" Then
        MsgBox "Export failed. Try Option 2 (XML Spreadsheet) instead.", vbCritical
        GoTo Cleanup
    End If

    ' Open the exported file so user can see it
    Workbooks.Open xlsxPath

    MsgBox "Done! Excel file saved to: " & xlsxPath, vbInformation
    GoTo Cleanup

AcrobatError:
    MsgBox "Acrobat error: " & Err.Description, vbCritical

Cleanup:
    On Error Resume Next
    Set jsObj   = Nothing
    If Not acroDoc Is Nothing Then acroDoc.Close
    If Not acroApp Is Nothing Then acroApp.Exit
    Set acroDoc = Nothing
    Set acroApp = Nothing

End Sub
